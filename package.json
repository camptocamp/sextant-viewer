{
  "name": "sextant-viewer",
  "author": "olivia.guyot@camptocamp.com",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "repository": "https://github.com/camptocamp/sextant-viewer",
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "docs:dev": "npm run docs:dev --workspace docs",
    "docs:build": "npm run docs:build --workspace docs",
    "preview:pages": "npm run build:lib -- --outDir pages && npm run docs:build && cp -r docs/.vitepress/dist/* pages && npx serve pages",
    "dev": "vite",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build:lib": "vite build",
    "build:app": "vite build --config vite.app.config.ts",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "knip": "knip",
    "format": "prettier --write --experimental-cli src/ index.html demo/",
    "format:check": "prettier -c --experimental-cli src/ index.html demo/"
  },
  "dependencies": {
    "@camptocamp/ogc-client": "^2.0.1",
    "@geospatial-sdk/core": "^0.0.5-dev.85.sha-86a77a3",
    "@geospatial-sdk/legend": "^0.0.5-dev.85.sha-86a77a3",
    "@geospatial-sdk/openlayers": "^0.0.5-dev.85.sha-86a77a3",
    "@nuxt/ui": "^4.11.1",
    "@types/sortablejs": "^1.15.9",
    "@vueuse/core": "^14.4.0",
    "ol": "^10.10.0",
    "pinia": "^3.0.4",
    "sortablejs": "^1.15.7",
    "uuid": "^14.0.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
