{
  "name": "sextant-viewer",
  "author": "olivia.guyot@camptocamp.com",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "repository": "https://github.com/camptocamp/sextant-viewer",
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "docs:dev": "npm run docs:dev --workspace docs",
    "docs:build": "npm run docs:build --workspace docs",
    "preview:pages": "npm run build:lib -- --outDir pages && npm run docs:build && cp -r docs/.vitepress/dist/* pages && npx serve pages",
    "dev": "vite",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build:lib": "vite build",
    "build:app": "vite build --config vite.app.config.ts",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "knip": "knip",
    "format": "prettier --write --experimental-cli src/ index.html demo/",
    "format:check": "prettier -c --experimental-cli src/ index.html demo/"
  },
  "dependencies": {
    "@camptocamp/ogc-client": "^1.3.1-dev.bb345f0",
    "@geospatial-sdk/core": "^0.0.5-dev.75",
    "@geospatial-sdk/legend": "^0.0.5-dev.75",
    "@geospatial-sdk/openlayers": "^0.0.5-dev.75",
    "@nuxt/ui": "^4.5.0",
    "@types/sortablejs": "^1.15.9",
    "@vueuse/core": "^14.1.0",
    "ol": "^10.9.0",
    "pinia": "^3.0.4",
    "sortablejs": "^1.15.6",
    "uuid": "^14.0.0",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tsconfig/node24": "^24.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-playwright": "^2.4.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-vue": "~10.6.2",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.2.2"
  }
}
