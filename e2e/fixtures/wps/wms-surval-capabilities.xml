<?xml version="1.0" encoding="UTF-8"?>
<!--
  A single filterable layer whose MetadataURL points at the GeoNetwork record declaring both the
  WFS resource (attribute filter) and the WPS resource (processes). Absolute URLs, in the CSW KVP
  form Sextant really emits: the record is then read cross-origin, as it is outside production.
-->
<WMS_Capabilities version="1.3.0" xmlns="http://www.opengis.net/wms"
                  xmlns:xlink="http://www.w3.org/1999/xlink">
  <Service>
    <Name>WMS</Name>
    <Title>Surval WMS</Title>
  </Service>
  <Capability>
    <Request>
      <GetCapabilities>
        <Format>text/xml</Format>
        <DCPType>
          <HTTP>
            <Get>
              <OnlineResource xlink:type="simple" xlink:href="https://sextant.ifremer.fr/services/wms/surval"/>
            </Get>
          </HTTP>
        </DCPType>
      </GetCapabilities>
      <GetMap>
        <Format>image/png</Format>
        <DCPType>
          <HTTP>
            <Get>
              <OnlineResource xlink:type="simple" xlink:href="https://sextant.ifremer.fr/services/wms/surval"/>
            </Get>
          </HTTP>
        </DCPType>
      </GetMap>
    </Request>
    <Layer>
      <Title>Surval WMS</Title>
      <CRS>EPSG:4326</CRS>
      <Layer queryable="1">
        <Name>surval</Name>
        <Title>Surval — données d'observation</Title>
        <CRS>EPSG:4326</CRS>
        <EX_GeographicBoundingBox>
          <westBoundLongitude>-5</westBoundLongitude>
          <eastBoundLongitude>10</eastBoundLongitude>
          <southBoundLatitude>42</southBoundLatitude>
          <northBoundLatitude>52</northBoundLatitude>
        </EX_GeographicBoundingBox>
        <BoundingBox CRS="EPSG:4326" minx="42" miny="-5" maxx="52" maxy="10"/>
        <MetadataURL type="ISO19115:2003">
          <Format>text/xml</Format>
          <OnlineResource xlink:type="simple"
                          xlink:href="https://sextant.ifremer.fr/geonetwork/srv/fre/csw?service=CSW&amp;request=GetRecordById&amp;id=uuid-surval"/>
        </MetadataURL>
      </Layer>
    </Layer>
  </Capability>
</WMS_Capabilities>
