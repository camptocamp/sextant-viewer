  <ProcessDescription wps:processVersion="1.0generic" storeSupported="true" statusSupported="true">
    <ows:Identifier>script:demo-inputs</ows:Identifier>
    <ows:Title>Ifremer input example</ows:Title>
    <ows:Abstract>This is a simple script to demonstrate wps capabilities</ows:Abstract>
    <DataInputs>
      <Input minOccurs="0" maxOccurs="1">
        <ows:Identifier>STRING</ows:Identifier>
        <ows:Title>A text string</ows:Title>
        <ows:Abstract>help</ows:Abstract>
        <ows:Metadata xlink:title="processing:type" xlink:href="string" xlink:type="simple"/>
        <LiteralData>
          <ows:DataType ows:reference="urn:ogc:def:dataType:OGC:1.1:string">string</ows:DataType>
          <ows:AnyValue/>
          <DefaultValue>test</DefaultValue>
        </LiteralData>
      </Input>
      <Input minOccurs="0" maxOccurs="1">
        <ows:Identifier>EXTENT</ows:Identifier>
        <ows:Title>A spatial extent</ows:Title>
        <ows:Metadata xlink:title="processing:type" xlink:href="extent" xlink:type="simple"/>
        <BoundingBoxData>
          <Default>
            <CRS>EPSG:4326</CRS>
          </Default>
          <Supported>
            <CRS>EPSG:4326</CRS>
          </Supported>
        </BoundingBoxData>
      </Input>
      <Input minOccurs="0" maxOccurs="1">
        <ows:Identifier>NUMBER</ows:Identifier>
        <ows:Title>A number</ows:Title>
        <ows:Metadata xlink:title="processing:type" xlink:href="number" xlink:type="simple"/>
        <LiteralData>
          <ows:DataType ows:reference="urn:ogc:def:dataType:OGC:1.1:float">float</ows:DataType>
          <ows:AllowedValues>
            <ows:Range ows:rangeClosure="closed">
              <ows:MinimumValue>-1.7976931348623157e+308</ows:MinimumValue>
              <ows:MaximumValue>1.7976931348623157e+308</ows:MaximumValue>
            </ows:Range>
          </ows:AllowedValues>
        </LiteralData>
      </Input>
      <Input minOccurs="0" maxOccurs="1">
