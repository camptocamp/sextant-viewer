{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "auto-imports.d.ts", "components.d.ts"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // @vue/tsconfig pins lib to ES2020; ES2021 is needed for String#replaceAll.
    "lib": ["ES2021", "DOM", "DOM.Iterable"],

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
